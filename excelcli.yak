__DESC__ = "经侦Excel/CSV数据分析工具，基于excelcli命令行实现Excel/CSV导入SQLite、字段映射、数据标准化、资金分析、SQL查询、交易筛选、涉税分析等完整工作流。本工具是处理Excel/CSV数据的唯一推荐方式，禁止使用Python/pandas/openpyxl自行读取Excel或自建入库流程。"
__VERBOSE_NAME__ = "经侦Excel/CSV数据分析工具(excelcli)"
__KEYWORDS__ = "excelcli,excel analysis,csv analysis,data import,sqlite,fund analysis,bank transactions,field mapping,normalize,sql query,transaction filter,tax analysis,invoice,资金分析,银行流水,交易分析,字段映射,数据标准化,涉税分析,发票分析,反洗钱,地下钱庄,电信诈骗,非法换汇,经济犯罪"

__USAGE__ = <<<USAGE_BLOCK
ExcelCLI Data Analysis Tool - Usage Guide for AI Parameter Generation

## Overview

excelcli is a native CLI tool for economic crime Excel/CSV analysis. It follows a strict workflow:
  import -> inspect -> map -> normalize -> analyze/query/transactions

IMPORTANT: This tool is the ONLY way to process Excel/CSV data. Do NOT use Python/pandas/openpyxl to read Excel files.

## Parameters

Required:
  subcommand   (string)  The complete excelcli subcommand with all arguments.
                            Examples: "import data.xlsx --case-id case001 --db case001.db"
                                      "inspect case001.db --json"
                                      "query case001.db --sql \"SELECT * FROM bank_transactions LIMIT 10\""
                            For complex multi-argument commands, MUST use AITAG format.

Optional:
  timeout      (int)     Max execution time in seconds. Default: 120.
                            import with large files: 120-300
                            inspect/map/normalize: 30-60
                            analyze/query/transactions: 30-120
                            tax commands: 30-60

## Command Reference

### Workflow 1: Bank Transaction Analysis

Step 1 - Import:    excelcli import <INPUT> --case-id <ID> --db <DB>
Step 2 - Inspect:   excelcli inspect <DB> --json --sample 5
Step 3 - Map:       excelcli map <DB> --out mapping.json
Step 4 - Normalize: excelcli normalize <DB> --mapping mapping.json
Step 5 - Analyze:   excelcli analyze fund <DB> --json
Step 6 - Query:     excelcli query <DB> --sql "<SQL>" --limit 100 --json
Step 7 - Filter:    excelcli transactions <DB> --account "xxx" --min-amount 10000

### Workflow 2: Tax Analysis

Step 1 - Import:    excelcli import 发票数据.xlsx --case-id tax001 --db tax001.db
Step 2 - Tax Map:   excelcli tax map tax001.db --out tax_mapping.json
Step 3 - Normalize: excelcli tax normalize tax001.db --mapping tax_mapping.json
Step 4 - Analyze:   excelcli tax analyze tax001.db --top 20 --json
Step 5 - Filter:    excelcli tax invoices tax001.db --taxpayer "某某公司" --csv

### Key Rules

1. ALWAYS execute steps in order: import -> inspect -> map -> normalize -> analyze
2. inspect MUST be run after import to confirm table/column structure before mapping
3. normalize requires a mapping file generated by the map command
4. After normalize, use bank_transactions standard table (NOT original Chinese column names) in SQL queries
5. Use --json flag for structured output, --csv for export to other tools
6. For query command, --sql and --file are mutually exclusive

### bank_transactions Standard Column Names (for SQL queries after normalize)

id, case_id, source_file, sheet_name, row_no, bank_name, account_no, account_name,
account_id_no, account_type, txn_time, direction, amount, balance,
counterparty_account, counterparty_name, counterparty_id_no, counterparty_bank,
summary, channel, remark

## Few-Shot Examples

Replace {NONCE} with the actual nonce from the response format section.

### Example 1: Import Excel data (basic)

User intent: "Import an Excel file for analysis"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "import_excel_data",
  "params": {
    "timeout": 180
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli import /path/to/交易流水.xlsx --case-id case001 --db /tmp/case001.db
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 2: Import CSV with encoding

User intent: "Import a GBK-encoded CSV file"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "import_csv_data",
  "params": {
    "timeout": 120
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli import /path/to/数据.csv --case-id case001 --db /tmp/case001.db --encoding gbk --verify
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 3: Inspect database structure

User intent: "Check the imported table structure"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "inspect_database",
  "params": {
    "timeout": 30
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli inspect /tmp/case001.db --json --sample 5
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 4: Generate field mapping

User intent: "Generate field mapping for bank transactions"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "generate_mapping",
  "params": {
    "timeout": 30
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli map /tmp/case001.db --out /tmp/mapping.json
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 5: Normalize data

User intent: "Standardize data using the mapping file"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "normalize_data",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli normalize /tmp/case001.db --mapping /tmp/mapping.json
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 6: Fund analysis

User intent: "Run fund flow analysis on the standardized data"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "fund_analysis",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli analyze fund /tmp/case001.db --json
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 7: Custom SQL query

User intent: "Query top counterparties by total amount"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "query_top_counterparties",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli query /tmp/case001.db --sql "SELECT counterparty_name, COUNT(*) as cnt, SUM(amount) as total FROM bank_transactions WHERE direction='out' GROUP BY counterparty_name ORDER BY total DESC" --limit 50 --json
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 8: Transaction filtering

User intent: "Filter large outgoing transactions"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "filter_large_transactions",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli transactions /tmp/case001.db --direction 出 --min-amount 50000 --limit 200 --json
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 9: Multi-condition transaction filter

User intent: "Filter transactions for a specific counterparty in a date range"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "filter_by_counterparty_date",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli transactions /tmp/case001.db --counterparty "张三" --start 2024-01-01 --end 2024-06-30 --csv
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 10: Tax analysis workflow

User intent: "Run tax risk analysis on invoice data"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "tax_analyze",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli tax analyze /tmp/tax001.db --taxpayer "某某公司" --start 2024-01-01 --end 2024-12-31 --top 20 --json
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 11: Tax invoice filtering

User intent: "Filter large invoices for a specific taxpayer"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "tax_invoice_filter",
  "params": {
    "timeout": 60
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli tax invoices /tmp/tax001.db --taxpayer "某某公司" --min-amount 100000 --csv
<|TOOL_PARAM_subcommand_END_{NONCE}|>

### Example 12: SQL query from file

User intent: "Execute complex SQL from a file for multi-step analysis"

```json
{
  "@action": "call-tool",
  "tool": "excelcli",
  "identifier": "query_from_sql_file",
  "params": {
    "timeout": 120
  }
}
```

<|TOOL_PARAM_subcommand_{NONCE}|>
excelcli query /tmp/case001.db --file /tmp/analysis.sql --limit 500 --csv
<|TOOL_PARAM_subcommand_END_{NONCE}|>

## Key Rules

1. ALWAYS set timeout explicitly based on command complexity.
2. Multi-argument commands -> ALWAYS use AITAG format for the subcommand parameter.
3. Follow the workflow order strictly: import -> inspect -> map -> normalize -> analyze.
4. After normalize, SQL queries MUST use standard English column names (e.g. account_no, counterparty_name),
   NOT original Chinese column names (e.g. 交易卡号, 对手户名).
5. Save mapping files and databases to /tmp/ for the working session.
6. Use --json for structured output that downstream steps can parse.
7. Use --csv when exporting data for use in other tools or reports.
USAGE_BLOCK

yakit.AutoInitYakit()

// 解析命令行参数
timeoutSeconds := cli.Int("timeout", cli.setRequired(false), cli.setHelp("the timeout seconds for the excelcli command, default 120. Commands exceeding this timeout will be killed."), cli.setDefault(120))
subcommand := cli.String("subcommand", cli.setRequired(true), cli.setHelp("the complete excelcli subcommand with all arguments, e.g. 'import data.xlsx --case-id case001 --db case001.db'"))

cli.check()

// 验证超时参数
if timeoutSeconds <= 0 {
    timeoutSeconds = 120
    yakit.Info("Invalid timeout value, using default 120 seconds")
}

// excelcli 二进制文件路径（直接写死，避免运行时查找失败）
excelcliPath = "/Volumes/code/JZ_Memfit_0511/ExcelCLI/target/release/excelcli"

yakit.Info("Using excelcli at: %v", excelcliPath)

// 构建完整命令
fullCommand = excelcliPath + " " + subcommand

// 创建带超时的上下文
ctx, cancel = context.WithTimeout(context.Background(), time.ParseDuration(sprint(timeoutSeconds) + "s")~)
defer cancel()

yakit.Info("Executing: %v", fullCommand)
yakit.Info("Timeout: %d seconds", timeoutSeconds)

// 执行命令
cmd, cmdErr = exec.CommandContext(ctx, fullCommand)

if cmdErr != nil {
    yakit.Error("Failed to create command: %v", cmdErr)
    return
}

// 创建输出缓冲区
stdoutbuf = bufio.NewBuffer()
stderrbuf = bufio.NewBuffer()
cmd.Stdout = stdoutbuf
cmd.Stderr = stderrbuf

// 执行并计时
startTime = time.Now()
err = cmd.Run()
elapsed = time.Since(startTime)
elapsedSec = int(elapsed.Seconds())
isTimeout = false
exitCode = 0

if err != nil {
    errStr = sprint(err)
    if str.Contains(errStr, "killed") || str.Contains(errStr, "signal: killed") || str.Contains(errStr, "context deadline exceeded") {
        isTimeout = true
        yakit.Info("COMMAND TIMEOUT: excelcli was killed after %d seconds.", timeoutSeconds)
        yakit.Info("SUGGESTION: For large files, increase timeout. For import, try 300s. For analyze/query, try 120s.")
    } else {
        if str.Contains(errStr, "exit status") {
            parts = str.Split(errStr, " ")
            if len(parts) >= 3 {
                exitCode = parseInt(parts[len(parts)-1])
            }
        }
        yakit.Error("excelcli command failed (exit code %d): %v", exitCode, err)
    }
}

// UTF-8 编码处理
toUtf8 = (s)=>{
    if os.OS == "windows" {
        res, err = codec.GBKSafe(s)
        if err {
            return codec.FixUTF8(s)
        }
        return res
    }
    return codec.FixUTF8(s)
}

// 输出执行结果
count := 0
if stdoutbuf.Len() > 0 {
    count++
    yakit.Info("Output:\n%v", toUtf8(stdoutbuf.String()))
}
if stderrbuf.Len() > 0 {
    count++
    stderrStr = toUtf8(stderrbuf.String())
    // 区分警告和错误
    if str.Contains(stderrStr, "error") || str.Contains(stderrStr, "Error") {
        yakit.Error("Stderr:\n%v", stderrStr)
    } else {
        yakit.Info("Stderr:\n%v", stderrStr)
    }
}
if count <= 0 {
    if isTimeout {
        yakit.Info("No output captured before timeout")
    } else {
        yakit.Info("No output. excelcli completed (possibly with empty output)")
    }
}

yakit.Info("Execution completed in %ds", elapsedSec)

// 针对数据操作的慢执行建议
if elapsedSec > 30 && !isTimeout {
    cmdStr = str.ToLower(subcommand)
    isImport = str.Contains(cmdStr, "import")
    isAnalyze = str.Contains(cmdStr, "analyze")
    isQuery = str.Contains(cmdStr, "query")
    isNormalize = str.Contains(cmdStr, "normalize")

    if isImport {
        yakit.Info("[SLOW IMPORT: %ds] Large file import completed.", elapsedSec)
        yakit.Info("[ADVICE] Run 'excelcli inspect <DB> --json' to verify the imported data structure.")
    } elif isAnalyze || isQuery {
        yakit.Info("[SLOW ANALYSIS: %ds] Query/analysis took a while.", elapsedSec)
        yakit.Info("[ADVICE] Use --json to save structured results. Use --limit to restrict output rows.")
    } elif isNormalize {
        yakit.Info("[SLOW NORMALIZE: %ds] Data normalization completed.", elapsedSec)
        yakit.Info("[ADVICE] Run 'excelcli analyze fund <DB> --json' for the fund analysis summary.")
    } else {
        yakit.Info("[SLOW EXECUTION: %ds] Command took over 30 seconds.", elapsedSec)
    }
}
