# codec plugin

/*
Codec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数

函数定义非常简单

func(i: string) string
*/
handle = origin => {
    output = ""

    origin = string(origin)

    inputs = make([]int64, 0, 10)

    if origin.Contains(",") {
        inputs = str.Split(origin, ",").Map(i => {return atoi(i.Trim())~})
    } else {
        inputs.Push(atoi(origin /*type: string*/)~)
    }

    for flow in db.QueryHTTPFlowsByID(inputs...) {
        prompt := "我有一个请求和响应流量数据包（HTTP），请你帮我检测这个数据包中有哪些敏感信息，我关注的是 accessKey secretKey 之类的，不要提供 User-Agent Referer ETag LastModified 之类的信息，帮我提取出来，放在 JSON 中，JSON 字段为 DATA，类型为 STRING，如果没有数据，告诉我'无数据'即可，可以不返回结果\n\n"
        prompt += flow.Request + "\n\n"
        prompt += flow.Response
        try {
            yakit.Info("Start to check: %v", flow.Url)
            result = ai.Chat(prompt)~
            for data in json.ExtractJSON(result) {
                output += json.loads(data)["DATA"] + "\n"
            }
            
        } catch e {
            yakit.Error(f`${e}`)
        }
    }

    println("----------------------------------------------------")
    dump(output)
    return output
}

