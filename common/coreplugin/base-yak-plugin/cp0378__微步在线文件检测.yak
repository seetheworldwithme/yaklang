yakit.AutoInitYakit()
log.info("info")

filepath = cli.String("filepath")
box_type = cli.String("box_type")
filename = re.Find(filepath,"\\w*\\W*.\\w*\\W*$")
filetext = file.ReadFile(filepath)

uploadpacket = `POST /v3/file/upload HTTP/1.1
Host: api.threatbook.cn
Accept: */*
Accept-Encoding: gzip, deflate
Accept-Language: zh-CN,zh;q=0.9
Content-Length: 770
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7jpEkzP0akzHqVaY
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/104.0.0.0 Safari/537.36

------WebKitFormBoundary7jpEkzP0akzHqVaY
Content-Disposition: form-data; name="apikey"

{{params(apikey)}}
------WebKitFormBoundary7jpEkzP0akzHqVaY
Content-Disposition: form-data; name="sandbox_type"

{{params(box_type)}}
------WebKitFormBoundary7jpEkzP0akzHqVaY
Content-Disposition: form-data; name="run_time"

60
------WebKitFormBoundary7jpEkzP0akzHqVaY
Content-Disposition: form-data; name="file"; filename="{{params(filename)}}"
Content-Type: application/octet-stream

{{params(filetext)}}
------WebKitFormBoundary7jpEkzP0akzHqVaY--`

reportpacket = `GET /v3/file/report/multiengines/?apikey={{params(apikey)}}&sha256={{params(sha256)}} HTTP/1.1
Host: api.threatbook.cn
Accept-Language: zh-CN,zh;q=0.9
Content-Length: 0
Content-Type: application/json
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/83.0.4103.116 Safari/537.36
`

// 处理 APIKey
yakit.Info("开始处理 APIKey 参数")
weibuAPIkeyFieldName = "threatbookapi"

yakit.Info("正在获取本地 APIKey 参数")
apikey = db.GetKey(weibuAPIkeyFieldName)

saveApiKey = cli.Bool("autosave-api-key")
if apikey == "" {
    apikey = cli.String("apikey")
}
if apikey == "" {
    yakit.Error("APIKey 为空")
    return
}else {
    yakit.Info("读取历史APIKey成功，APIKey：%v", apikey)
}
if saveApiKey {
    db.SetKey(weibuAPIkeyFieldName, apikey)
    yakit.Info("成功保存APIKey，下次查询无需输入")
}

uploadrsp, uploadreq, uploaderr = poc.HTTP(uploadpacket, poc.params({"apikey":apikey,"filename":filename,"filetext":filetext,"box_type":box_type}),poc.https(true))
if uploaderr != nil {
    yakit.Error(string(uploaderr))
    return
}
uploadhander, uploadbody = str.SplitHTTPHeadersAndBodyFromPacket(uploadrsp)
uploaddata = json.loads(uploadbody)

if str.Compare(parseString(uploaddata["response_code"]), "0") == 0 {
    yakit.Info("测试文件上传成功")
}else {
    yakit.Error("测试文件上传失败，失败原因%v", parseString(uploaddata["verbose_msg"]))
    return
}
sha256 = parseString(uploaddata["data"]["sha256"])

reportrsp, reportreq, reporterr = poc.HTTP(reportpacket, poc.params({"apikey":apikey,"sha256":sha256}),poc.https(true))
if reporterr != nil {
    yakit.Error(string(reporterr))
    return
}
reportheader, reportbody = poc.Split(reportrsp)
reportdata = json.loads(reportbody)
if str.Compare(parseString(reportdata["response_code"]), "0") == 0 {
    yakit.Info("报告获取成功")
    yakit.Text(string(reportbody))
    yakit.EnableTable("微步在线病毒文件查询插件", ["文件名","威胁等级","是否为白名单文件","病毒类型","病毒家族","最近扫描时间"])
    outputData = def(key,key2,key3,key4,key5,key6){
        data = make(map[string]var)
        data["文件名"] = key
        data["威胁等级"] = key2
        data["是否为白名单文件"] = key3
        data["病毒类型"] = key4
        data["病毒家族"] = key5
        data["最近扫描时间"] = key6
        yakit.Output(yakit.TableData("微步在线病毒文件查询插件", data))
    }
    if str.Compare(parseString(reportdata["data"]["multiengines"]["threat_level"]), "clean") == 0 {
        outputData(filename,parseString((reportdata["data"]["multiengines"]["threat_level"])),parseString(reportdata["data"]["multiengines"]["is_white"]),"无","无",parseString(reportdata["data"]["multiengines"]["scan_date"]))
    }else {
        outputData(filename,parseString((reportdata["data"]["multiengines"]["threat_level"])),parseString(reportdata["data"]["multiengines"]["is_white"]),parseString(reportdata["data"]["multiengines"]["malware_type"]),parseString(reportdata["data"]["multiengines"]["malware_family"]),parseString(reportdata["data"]["multiengines"]["scan_date"]))
    }
  
}else {
    yakit.Error("测试文件上传失败，失败原因%v", parseString(uploaddata["verbose_msg"]))
    return
}

