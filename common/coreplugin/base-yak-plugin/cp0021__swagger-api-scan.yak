func check_dict_file_content(dict_file_content){
    # 该函数通过检测字典路径是否有内容，如果用户没有输入字典路径，就使用默认字典
    if dict_file_content == nil{
        yakit.Info("检测到字典路径为空,使用默认字典")
        return default_dict_list
    }else{
        return dict_list
    }
}

func get_risk(raw_url){
    risk.NewRisk(
    raw_url,
    risk.title("%v存在敏感信息泄露"%raw_url),
    risk.description(DESC),
    risk.solution(SOLUTION),
    risk.type("sensitive-disclosure"),
    risk.typeVerbose("敏感信息泄漏"),
    risk.level("low"),
    risk.payload(raw_url),
    )
}

func check_sensitive_data(raw_url,json_data,table_map){
    for sensitive_re_key,sensitive_re_value := range sensitive_re{
        re_result = re.FindAll(json_data,sensitive_re_value)
        if re_result != nil {
            yakit.Info(f`${raw_url}存在敏感信息泄露`)
            table_map["json敏感信息泄露"] = "true"
            data = f`
url:${raw_url}
使用的正则表达式:${sensitive_re_value}
匹配到的信息:${sensitive_re_key}
匹配到的结果是:${re_result}
`
    sensitive_data_list.Append(data)
    vuln_url_list.Append(raw_url)
    }else{
        table_map["json敏感信息泄露"] = "false"
    }
    }
    return table_map
}


dict_list = check_dict_file_content(dict_file_content)
default_dict_list=str.RemoveRepeat(default_dict_list)
dict_list_len = len(dict_list)
println("字典长度是%v"%dict_list_len)

progress_scale = 1/(float(dict_list_len)*len(urls))
rate_progress = 0

func sendpacket(target){
    # 该函数负责发送数据包
    defer func (){
        wg.Done()
        lock.Lock()
        rate_progress = progress_scale + rate_progress
        lock.Unlock()
        yakit.StatusCard("任务状态","正在进行任务")
        yakit.SetProgress(rate_progress)
        
    }()

    response,request,err = poc.Do("GET", target,poc.replaceRandomUserAgent(),poc.timeout(5),poc.retryTimes(3),poc.retryInStatusCode(500,502),poc.connectTimeout(10))

    response_server_time = response.TraceInfo.ServerTime
    
    if err != nil{
        panic(err)
    }
   
    rspIns,_ = poc.ParseBytesToHTTPResponse(response.RawPacket)
    
    content_type = poc.GetHTTPPacketContentType(response.RawPacket)
    
    
    if err!=nil{
        panic(err)
    }

    // yakit.Info(f`扫描了${response.Url},状态码是${rspIns.StatusCode},数据包长度是${response.ResponseBodySize}`)
    

    text = string(response.GetBody())
    title = str.ExtractTitle(text)
    table_map = make(map[string]var)
    table_map['方法'] = "GET"
    table_map['状态码'] = rspIns.StatusCode
    table_map['url'] = response.Url
    table_map['响应长度'] = string(response.ResponseBodySize)+"B"
    table_map['title'] = title
    // table_map['响应时间'] = response_server_time
    table_map['响应类型'] = content_type
    

    if (re.Find( text.Lower(),"(swagger ui|openapi[1-3])")){
        yakit.Info(f`${response.Url} 存在swagger ui泄露`)
            risk.NewRisk(
    target,
    risk.title("%v存在swagger ui泄露"%target),
    risk.description(DESC),
    risk.solution(SOLUTION),
    risk.type("sensitive-disclosure"),
    risk.typeVerbose("敏感信息泄漏"),
    risk.level("low"),
    risk.payload(target),
    )

        table_map["swagger ui"] = "true"
    }else{
        table_map["swagger ui"] = "false"
    }

    json_data = str.ExtractJson(text)

    if  json_data != nil{ 
        table_map = check_sensitive_data(target, json_data,table_map)
    }

    yakit.Output(yakit.TableData("扫描结果", table_map))
}
for url in urls{
    url = check_url(url)
    for num,path = range dict_list{
    wg.add(1)
    full_url,err = str.UrlJoin(url,path)
    if err != nil{
        yakit.Error("发现错误", err)
    }

    go sendpacket(full_url)
}
}

wg.Wait()

yakit.TextTabData("匹配到的敏感信息", str.Join(str.RemoveRepeat(sensitive_data_list),""))
yakit.SetProgress(1)

if vuln_url_list != nil{
    for vuln_url in str.RemoveRepeat(vuln_url_list){
    get_risk(vuln_url)
}
}


defer yakit.StatusCard("任务状态","任务完成")


