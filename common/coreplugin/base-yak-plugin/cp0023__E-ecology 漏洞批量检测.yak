rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}


