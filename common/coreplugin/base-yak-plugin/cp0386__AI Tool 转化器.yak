yakit.AutoInitYakit()

# Input your code!
filePathList = cli.FileNames("filePath", cli.setVerboseName("yak脚本路径"))
yakPlugin = cli.StringSlice("yakit-plugin-name", cli.setMultipleSelect(true),cli.setRequired(true),cli.setVerboseName("yakit原生插件名"))
keywords = cli.StringSlice("keywords", cli.setMultipleSelect(true),cli.setVerboseName("工具关键词"))
description = cli.String("desc", cli.setVerboseName("工具简述"))
toolPath = cli.String("toolPath", cli.setVerboseName("工具语义路径"))
isFavorite = cli.Bool("favorite", cli.setVerboseName("标记工具为偏好工具"))

cli.check()

scriptData = []

addScriptData = func(name,content) {
    scriptData = append(scriptData, {
        "name":name,
        "content":content,
    })
}

yakit.StatusCard("执行状态", "获取输入插件内容")

for name in yakPlugin {
    plugin,err := db.GetYakitPluginByName(name)
    if err != nil {
        yakit.Error("查找yakit插件 [%s] 失败 [%v]", name,err)
        continue
    }
    if plugin.Type != "yak" {
        yakit.Info("yakit插件 [%s] 不是yak原生插件，其类型为[%s]", name,plugin.Type)
        continue
    }
    addScriptData(plugin.ScriptName,plugin.Content)
}


for path in filePathList {
    info, err = file.Stat(path)
    if err != nil {
        yakit.Error("查看文件信息 [%s] 失败 [%v]", path,err)
        continue
    }
    name = info.Name()
    content,err :=  file.ReadFile(path)
    if err != nil {
        yakit.Error("读取文件 [%s] 失败 [%v]", path,err)
        continue
    }
    addScriptData(name,content)
}

yakit.StatusCard("执行状态", "分析插件内容，生成工具元数据，存入数据库")
for data in scriptData {
    yakit.StatusCard("正在分析", data.name)
    newContent,metaData,err := aiagent.UpdateYakScriptMetaData(data.name, data.content, true)
    if err != nil {
        yakit.Error("插件 [%s] 生成元数据 失败 [%v]", data.name,err)
        continue
    }

    aitool = aiagent.ParseYakScriptToAiTools(data.name,newContent)

    if len(keywords) > 0 {
        aitool.Keywords = str.Join(append(aitool.Keywords, keywords...), ",")
    }
    if len(description) > 0 {
        aitool.Description = aitool.Description + "\n" + description
    }
    if len(toolPath) > 0 {
        aitool.Path = toolPath
    }
    db.SaveAIYakScript(aitool)
}









