# port scan plugin
yakit.AutoInitYakit()

/*
本插件定义的函数主要用于端口扫描的额外扩展

函数定义如下：
func(result *fp.MatchResult)

// 详细结构体定义与内容见模版结尾
// 这里最关键的是，如果对扫描出的结果有疑问，需要对 MatchResult 进行修改，应该直接
// 对变量.Field 进行修改。

DEMO:

handle = func(result) {
    if result.Fingerprint != nil {
        if result.Port == 80 && result.GetServiceName() == "" {
            result.Fingerprint.ServiceName = "http"
        }
    }
}

*/

openSSHCVE = []
addCVE = func(cve, rules, score, severity, titleZh, titleEn) {
    if (str.Contains(rules, ",")) {
        rules = str.Join(x.Map(str.Split(rules, ","), func(i) {
            return sprintf(`(%v)`, str.ReplaceAll(str.TrimSpace(i), ".", `\.`))
        }), "|")
    }
    openSSHCVE = append(openSSHCVE, {
        "cve": cve,
        "rule": rules,
        "score": score,
        "severity": severity,
        "titleZh": titleZh,
        "titleEn": titleEn, 
    })
}

// 2010-01-01 00:00:00
// cvss > 6.0
addCVE("CVE-2020-15778", `8\.3`, "6.8", "MEDIUM", "OpenSSH(有争议) scp.c 命令注入漏洞", "OpenSSH scp.c command injection (DISPUTED)")
