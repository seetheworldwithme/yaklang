# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 
PacketGet = `GET /admin/ HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`
PacketGet1 = `GET /admin/ HTTP/1.1
Host: {{params(target)}}
Authorization: Basic YWRtaW46YWRtaW4=
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`

//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//填充对应的漏洞检测规则
addRule(PacketGet,`/`,func(rsp,header,body){
    if str.MatchAnyOfSubString(body, `javax.ws.rs.WebApplicationException`){
        return true
    }
    return false
},"默认口令","activemq-default-password","critical","https://blog.csdn.net/ge00111/article/details/72765210")

//漏洞检测handle 
handleRule = func(isTls, addr, rule) {

    defer func{
        recover()
    }
    

    resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.proxy("http://127.0.0.1:8083"))
    if err != nil {
        yakit.Error("poc.HTTP error: %v", err)
        return
    }
    header, body = poc.Split(resp)
    rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
    urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
    url = urlIns.String()
    if rule.check(rspIns, header, body) {
        yakit.Info("FOUND INFO for %v", rule.typeVerbose)
        risk.NewRisk(
            url, risk.severity(rule.severity), 
            risk.title(sprintf("FOUND %v", rule.typeVerbose)),
            risk.titleVerbose(sprintf("reference %v", rule.reference)),
            risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
            risk.payload(rule.payload), risk.details({
                "request": req,
                "response": resp,
                "url": url,
            }),
        )
        return
    }
    return

}

handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }

    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    for _, rule = range rules {
        handleRule(isTls, addr, rule)
    }
}
