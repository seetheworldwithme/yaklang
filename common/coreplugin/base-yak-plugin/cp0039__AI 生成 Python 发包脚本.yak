handle = func(origin /* string */) {
    buf := ""

    if str.MatchAllOfRegexp(origin, `^[0-9]+`) {
        flowId := atoi(origin)~
        key := f"HTTPFlow:${flowId}"
        yakit.StatusCard(key, "开始生成")
        for result in db.QueryHTTPFlowsByID(flowId) {
            prompt := f`我给你一个 HTTP Request，请你帮我生成一个 Python 脚本发送者个请求，使用 requests 库，尽量不要使用特别生僻的库，脚本使用 Markdown 的代码样式包裹起来，方便我复制粘贴，请求 URL 是 ${result.Url} 原始数据包是：${result.Request}`
            chatResult, err = ai.Chat(prompt)
            if err != nil {
                yakit.StatusCard(key, f"AI 生成错误：${err}")
                continue
            }
            
            buf += chatResult
            yakit.StatusCard(key, "生成完成")
        }
        
        return buf
    }
    
    prompt := f`我给你一个 HTTP Request，请你帮我生成一个 Python 脚本发送者个请求，使用 requests 库，尽量不要使用特别生僻的库，脚本使用 Markdown 的代码样式包裹起来，方便我复制粘贴，原始数据包是：${string(origin)}`
    chatResult, err = ai.Chat(prompt)
    if err != nil {
        yakit.StatusCard("状态", f"AI 生成错误：${err}")
        return ""
    }
    
    buf += chatResult
    yakit.StatusCard("状态", "生成完成")
}
