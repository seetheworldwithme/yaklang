# codec plugin

/*
Codec Plugin 可以支持在 Codec 中自定义编码解码，自定义 Bypass 与字符串处理函数

函数定义非常简单

func(i: string) string
*/
// isValidMD5 验证 MD5 哈希格式
func isValidMD5(hash) {
  if (len(hash) == 32 || len(hash) == 16){
    return true
  }else{
    return false
  }
}
// decrypt 尝试解密 MD5 哈希值
func decrypt(md5Hash) {
    // 输入验证
    if !isValidMD5(md5Hash) {
        die("Invalid MD5 hash format: expected 32-character hex string")
    }

    // 构造请求包
    requestPacket = `
POST /api/md5/decrypt HTTP/1.1
Host: zmd5_api.sec-lab.cn
Accept: */*
Referer: https://zmd5.sec-lab.cn/
Content-Type: application/json
Accept-Encoding: gzip, deflate, br, zstd
Sec-Fetch-Mode: cors
Content-Length: 43

{"text":"{{params(md5Hash)}}"}
`

    // 发送 HTTP 请求
    rsp, req, err = poc.HTTP(
        requestPacket,
        poc.params({"md5Hash":md5Hash}),
        poc.https(true),
        poc.redirectTimes(0),
    )
    die(err)

    // 解析响应
    body = poc.GetHTTPPacketBody(rsp)
    respData = json.loads(body)

    // 处理 API 响应
    if respData["success"] {
        plainText = respData["data"]["original"]
        return("找到明文："+plainText)
    } else {
      return("未找到对应的原文")
    }
}



// handle 处理入口函数
func handle(origin) {
    try {
        return decrypt(origin)
    } catch err {
        log.error("MD5 decrypt failed: %v", err)
        return nil
    }
}
