yakit.AutoInitYakit()
log.setLevel("info")

// this code generated by yaklang from database
thread = cli.Int("thread", cli.setDefault(10))
targets = cli.Text("targets", cli.setHelp("目标域名，请按行分割，如\nqq.com\n2345.com\nhttps://www.yuque.com/dashboard"),cli.setVerboseName("目标域名"),cli.setRequired(true))
cli.check()


targets = str.ParseStringToLines(targets)
//表格函数
yakit.EnableTable("子域名表", ["target", "子域名"])
domaintable = func(target,domain_list) {
    data = make(map[string]var)
    data["target"] = target
    data["子域名"] = domain_list
    yakit.TableData("子域名表", data)
}
yakit.EnableTable("权重信息", ["target", "百度权重", "移动权重", "360权重","神马","搜狗","谷歌PR"])
ranktable = func(target,baidurank,baidurank_mbr,y360_pr,sm_pr,sogou_pr,google_pr) {
    data = make(map[string]var)
    data["target"] = target
    data["百度权重"] = baidurank
    data["移动权重"] = baidurank_mbr
    data["360权重"] = y360_pr
    data["神马"] = sm_pr
    data["搜狗"] = sogou_pr
    data["谷歌PR"] = google_pr
    yakit.TableData("权重信息", data)
}
yakit.EnableTable("备案信息", ["target", "备案号", "性质", "名称","审核时间"])
icptable = func(target,icp_icp,icp_type,icp_company,icp_passtime) {
    data = make(map[string]var)
    data["target"] = target
    data["备案号"] = icp_icp
    data["性质"] = icp_type
    data["名称"] = icp_company
    data["审核时间"] = icp_passtime
    yakit.TableData("备案信息", data)
}

/*域名SEO综合查询
*/
func seo(target,swg){
    swg.Add()
    go func{
        defer swg.Done()
        defer func{
            recover()
        }
        if len(str.ExtractDomain(target))!=0{
            target=str.ExtractDomain(target)[0]
        }else{
            log.Error("%v格式有误",target)
            yakit.Error("%v格式有误",target)
            return 
        }

        if !str.EndsWith(target,"/"){
            target = target +"/"
        }
        url = "https://www.aizhan.com/cha/"+target
        rsp, req = poc.Get(url, poc.replaceRandomUserAgent())~
        doc = xpath.LoadHTMLDocument(rsp.RawPacket)~
        ranks = []
        icp = []
        domain_list = []
        //权重
        getRank = func(typ) {
            rankSrc = xpath.SelectAttr(xpath.FindOne(doc, f`//*[@id="${typ}"]/img`), "src")
            splited = rankSrc.Split("/")
            rank = splited[-1].TrimRight(".png")
            return rank
        }
        baidurank = getRank("baidurank_br") 
        baidurank_mbr = getRank("baidurank_mbr") 
        y360_pr = getRank("360_pr") 
        sm_pr = getRank("sm_pr") 
        sogou_pr = getRank("sogou_pr") 
        google_pr := getRank("google_pr") 
        ranks = append(ranks, baidurank, baidurank_mbr, y360_pr, sm_pr, sogou_pr, google_pr)

        //备案信息
            icp_icp := xpath.InnerText(xpath.FindOne(doc, `//*[@id="icp_icp"]`))
            icp_type := xpath.InnerText(xpath.FindOne(doc, `//*[@id="icp_type"]`))
            icp_company := xpath.InnerText(xpath.FindOne(doc, `//*[@id="icp_company"]`))
            icp_passtime := xpath.InnerText(xpath.FindOne(doc, `//*[@id="icp_passtime"]`))
            icp = append(icp,icp_icp,icp_type,icp_company,icp_passtime)

        if xpath.FindOne(doc, `//*[@id="domain_list"]`)!=nil{
            domain_list = xpath.InnerText(xpath.FindOne(doc, `//*[@id="domain_list"]`))
            domain_list = str.ParseStringToLines(domain_list)
        }

        
        ranktable(str.ExtractDomain(target),baidurank,baidurank_mbr,y360_pr,sm_pr,sogou_pr,google_pr)
        icptable(str.ExtractDomain(target),icp_icp,icp_type,icp_company,icp_passtime)
        for i,j := range domain_list{
            domaintable(str.ExtractDomain(target),j)
        }
        log.Info("%v %v %v %v",str.ExtractDomain(target),ranks,icp,domain_list)
        return str.ExtractDomain(target),ranks,icp,domain_list
    }
}

swg = sync.NewSizedWaitGroup(thread)
for _,target :=range targets{
    seoresult:=seo(target,swg)
}
swg.Wait()
