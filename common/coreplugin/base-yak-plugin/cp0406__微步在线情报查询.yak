

log.setLevel("info")  // 设置日志级别
yakit.AutoInitYakit()
yakit.Info("使用微步在线API，免费额度50个/日")
yakit.Info("可以同时最多查询100个IP，以 , 分隔")

input_target = cli.String("target", cli.setHelp("请输入输入IP，可输入多个IP，使用 , 分隔"),cli.setVerboseName("目标IP"),cli.setRequired(true))
input_api =  cli.String("threatbookapi", cli.setHelp("微步在线API，免费额度50个/日\n可在https://x.threatbook.cn/v5/myApi查看"),cli.setVerboseName("微步API"))
cli.check()

target = str.LowerAndTrimSpace(input_target)
if target == "" {
    die("no target")
}
split = false 
if str.MatchAllOfSubString(target, ",") {
    target = str.ParseStringToHosts(target)
    split = true
}
if str.MatchAllOfSubString(target, "，") {
    yakit.Error("请使用英文,字符分隔IP")
    return
}
threatbookapi = str.LowerAndTrimSpace(input_api)
yakit.Info("查询IP:%v",target)
yakit.Info("输入的微步API:%v",threatbookapi)

apikey = ""

if threatbookapi != "" {
    yakit.Info("设置新的API%v",threatbookapi)
    db.SetKey("threatbookapi",threatbookapi)
    apikey = db.GetKey("threatbookapi")
}else{
    apikey = db.GetKey("threatbookapi")
    yakit.Info("没有获取到API，正在尝试读取历史API")
    if apikey != ""{
        yakit.Info("读取历史API成功%v",apikey)
      
    }else{
        yakit.Error("获取历史API失败")
    }
}

yakit.Info("正在使用微步API:%v",apikey)
url = ""
if split == true {
    ip = ""
    ips = "" 
    for n:=0 ;n<len(target); n++ {
        ip = ip + "&resource="+ target[n]
        ips = ip
    }
    url = "https://api.threatbook.cn/v3/scene/ip_reputation?apikey="+apikey+ips+"&lang=zh"
}else {
    url = "https://api.threatbook.cn/v3/scene/ip_reputation?apikey="+apikey+"&resource="+target+"&lang=zh"
}


rsp, _, err = poc.Get(url, poc.replaceRandomUserAgent())
if err != nil {
    yakit.Error("微步API请求失败，错误原因:%v",err)
}
die(err)


rspRaw = rsp.RawPacket
headers, body = str.SplitHTTPHeadersAndBodyFromPacket(rspRaw)
die(err)
yakit.Info("微步API请求成功")
yakit.Text(string(body))
t = json.loads(body)

if parseString(t["response_code"]) == "0" {
    yakit.EnableTable("微步在线情报查询插件", ["IP","ASN","是否恶意","国家","可信度","威胁类型","运营商","更新时间"])

    outputData = def(key,key2,key3,key4,key5,key6,key7,key8){
        data = make(map[string]var)
        data["IP"] = key
        data["ASN"] = key2
        data["是否恶意"] = key3
        data["国家"] = key4
        data["可信度"] = key5
        data["威胁类型"] = key6
        data["运营商"] = key7
        data["更新时间"] = key8
        yakit.Output(yakit.TableData("微步在线情报查询插件", data))
    }
    if split == true {
        for n:=0 ;n<len(target); n++ {
            outputData(target[n], "ASN" + parseString(t["data"][target[n]]["asn"]["number"]),parseString(t["data"][target[n]]["is_malicious"]),t["data"][target[n]]["basic"]["location"]["country"],t["data"][target[n]]["confidence_level"],t["data"][target[n]]["judgments"],t["data"][target[n]]["basic"]["carrier"],t["data"][target[n]]["update_time"])
        }
    }else {
        outputData(target, "ASN" + parseString(t["data"][target]["asn"]["number"]),parseString(t["data"][target]["is_malicious"]),t["data"][target]["basic"]["location"]["country"],t["data"][target]["confidence_level"],t["data"][target]["judgments"],t["data"][target]["basic"]["carrier"],t["data"][target]["update_time"])
    }
}else{
    yakit.Error("微步API请求失败，错误原因:%v",parseString(t["verbose_msg"]))
}



