yakit.AutoInitYakit()

handleCheck = func(target,port){
    var url
    addr = str.HostPort(target, port)
    isTls = str.IsTLSServer(addr)
    level=["","low","middle","high","critical"]
    if isTls {
        url="https://"+addr
    }else{
        url="http://"+addr
    }
    vulnable=false

    reference="minio default password 漏洞"
    severity="未填写"
    type="漏洞"

    poc_url_poc10= url + `/minio/webrpc`
    req_poc10, _ := http.NewRequest("POST",poc_url_poc10,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/json`),
    http.body(`{"id":1,"jsonrpc":"2.0","params":{"username":"minioadmin","password":"minioadmin"},"method":"Web.Login"}`),)
    breq,_=http.dump(req_poc10)
    resp_poc10, err := http.Do(req_poc10)
    die(err)
    bresp,_=http.dump(resp_poc10)
    header, body = poc.Split(bresp)
    poc10_flag = false
    if resp_poc10.StatusCode == 200 && str.Contains(string(header),"json") && str.Contains(string(body),"uiVersion") && str.Contains(string(body),"token"){
        poc10_flag = true
    }

    poc_url_poc20= url + `/minio/webrpc`
    req_poc20, _ := http.NewRequest("POST",poc_url_poc20,http.noredirect(),
    http.header("Content-Type", `application/x-www-form-urlencoded`),
    http.header(`Content-Type`,`application/json`),
    http.body(`{"id":1,"jsonrpc":"2.0","params":{"username":"minioadmin","password":"minioadmin"},"method":"web.Login"}`),)
    breq,_=http.dump(req_poc20)
    resp_poc20, err := http.Do(req_poc20)
    die(err)
    bresp,_=http.dump(resp_poc20)
    header, body = poc.Split(bresp)
    poc20_flag = false
    if resp_poc20.StatusCode == 200 && str.Contains(string(header),"json") && str.Contains(string(body),"uiVersion") && str.Contains(string(body),"token"){
        poc20_flag = true
    }

    poc_url=poc_url_poc20
    if poc10_flag || poc20_flag{
        vulnable = true
    }
    if vulnable {
            yakit.Info("FOUND INFO for %v %v",reference,type)
            risk.NewRisk(
                url, risk.severity(severity), 
                risk.title(sprintf("FOUND %v %v",reference,type)),
                risk.titleVerbose(sprintf("%v %v",reference,type)),
                risk.type(type), risk.typeVerbose(type),
                risk.details({
                    "request": breq,
                    "response": bresp,
                    "url": poc_url,
                }),
            )
        }
    return
}
handle = func(result) {
    if !result.IsOpen(){
        return
    }
    if len(result.Fingerprint.HttpFlows)>0{
        handleCheck(result.Target,result.Port)
    }
}
